{
  "name": "emberline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Wildfire progression, drone hot-spot tracking and firefighting operations on a 3D map, rebuilt from open satellite data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "python -m pytest pipeline/tests -q",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "maplibre-gl": "5.24.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
